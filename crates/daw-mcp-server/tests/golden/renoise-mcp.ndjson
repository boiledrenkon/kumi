otations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"instrument_save","title":"Save a Renoise instrument","description":"Saves an instrument to an .xrni file at path (absolute; the extension is added when missing), never over a file already there unless path names that file exactly and overwrite: true. Not a change: no undo.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"instrumentRef":{"type":"string","description":"The instrument."},"ref":{"type":"string","description":"The instrument (as instrumentRef)."},"path":{"type":"string"},"overwrite":{"type":"boolean"},"epoch":{"type":"string"},"layout":{"type":"integer","minimum":0}},"required":["path"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"catch_up","title":"What changed in Renoise","description":"What changed in the open Renoise project since this host last kept its snapshot (edits made while Kumi was closed, or while Renoise was restarted): {place, name, lastSeenAt, project: [details], changes: [added | removed | changed], more?, same?}, or first: true when there is no snapshot yet. The snapshot is kept again afterwards.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"idempotentHint":false,"openWorldHint":false}},{"name":"baseline_save","title":"Keep the Renoise project's snapshot","description":"Keeps the open Renoise project's snapshot again, so the next catch_up tells only what changes after now. Refused (saved: false) until catch_up has compared this project, so what changed while Kumi was away is never lost.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"watch_start","title":"Watch Renoise","description":"Starts watching the producer work in Renoise: the project as it is now is kept, and what they add is looked at as it comes. Nothing in Renoise changes.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"watch_stop","title":"Stop watching Renoise","description":"Stops watching and says what the producer did since watch_start: {watched, changes (with each value before and after, what an added thing is made of, the parameters they moved by name), project, selected (the tracks they selected)}.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"idempotentHint":false,"openWorldHint":false}}]}}
