otentHint":true,"openWorldHint":false}},{"name":"focus","title":"Renoise focus","description":"What the producer is looking at in Renoise: {epoch, view, selection, transport, changed}. Cheap enough to poll about every 150 ms; read again only when changed moves.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"focus_body","title":"Renoise view","description":"What Renoise shows in one of its views, ready to draw: pass kind, and ref (the take, track or pattern it is about) or window (the range to show) where the kind takes them. Long ones come in pages: pass the nextCursor as cursor.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"kind":{"type":"string","enum":["pattern","matrix","phrase","instrument","dsp"],"description":"Which view."},"ref":{"type":"string","description":"The ref of what the view is about."},"around":{"type":"string","description":"The ref of a track to centre the first page of tracks on (the arrange view): the page starts half a page above it, and says where in `from`."},"window":{"type":"object","properties":{"from":{"type":"number"},"to":{"type":"number"}},"required":["from","to"],"additionalProperties":false,"description":"The range to show, in the view's own units."},"cursor":{"type":"string","description":"The nextCursor an earlier page gave, unchanged."},"limit":{"type":"integer","minimum":1,"maximum":200,"description":"Rows in a page."},"layout":{"t