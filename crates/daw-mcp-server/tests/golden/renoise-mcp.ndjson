un."},"sequence":{"type":"integer","minimum":1},"line":{"type":"integer","minimum":1},"epoch":{"type":"string"}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"cursor_set","title":"Move Renoise's cursor","description":"Moves Renoise's edit cursor to positionBeats (quarter notes from the start) or position (seconds); the play position follows while it plays.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"positionBeats":{"type":"number","minimum":0},"position":{"type":"number","minimum":0},"epoch":{"type":"string"}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"undo_step_begin","title":"Begin one Renoise undo step","description":"Opens one step of Renoise's undo around the changes that follow, where Renoise gives one: {stepId}. Close it with undo_step_end.","inputSchema":{"type":"object","properties":{"label":{"type":"string"}},"required":["label"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},{"name":"undo_step_end","title":"End the Renoise undo step","description":"Closes the step undo_step_begin opened; label names it in Renoise's undo by what it did.","inputSchema":{"type":"object","properties":{"stepId":{"type":"string"},"label":{"type":"string","maxLength":200}},"required":["stepId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"change_release","title":"Forget changes","description":"Changes that won't be undone any more: the host forgets them 