{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"preset_save","title":"Save a device's preset","description":"Saves a native device's settings as a preset file named name in Renoise's user library (Effect Presets, in the device's folder): {file, listed}. Renoise lists it in the device's presets from its next start. A preset of that name is replaced only with replace; plug-ins are refused (Renoise lists only the presets it saves for them).","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"ref":{"type":"string","description":"A device on a track"},"epoch":{"type":"string"},"layout":{"type":"integer","minimum":0},"name":{"type":"string","maxLength":128},"replace":{"type":"boolean"}},"required":["ref","name"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},{"name":"audition_note","title":"Audition a note in Renoise","description":"Plays a note (or notes, at once) on an instrument, out loud, for durationMs, on track (the selected one by default); sample plays that sample alone. stop: true ends what is playing.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"instrument":{"type":"string","description":"The instrument's ref."},"instrumentRef":{"type":"string","description":"The instrument's ref (as instrument)."},"track":{"type":"string","description":"The track's ref to play on."},"trackRef":{"type":"string","description":"The track's ref (as track)."},"note":{"